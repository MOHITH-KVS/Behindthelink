{
  "manifest_version": 3,
  "name": "BehindTheLink",
  "version": "0.1.0",
  "description": "See what's behind the link before you click.",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/constants.js",
        "src/content/link-eligibility.js",
        "src/content/tracking-registry.js",
        "src/content/shortener-registry.js",
        "src/content/affiliate-registry.js",
        "src/content/url-analyzer.js",
        "src/content/context-extractor.js",
        "src/content/preview-ui.js",
        "src/content/hover-manager.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "assets/icons/icon-16.png",
    "48":  "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js"
  }
}
